Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 500
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.35
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        robotnik_simple: {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot/robot_description
      Enabled: true
      Name: Robot Model
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 118; 210
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.08
      Length: 0.08
      Line Style: Lines
      Line Width: 0.04
      Name: Base Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 25; 118; 210
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.03
      Shaft Length: 0.06
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /base_path
      Value: true
    - Alpha: 0.45
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 30; 144; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.02
      Name: Base Path Original
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /base_path_original
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 216; 67; 21
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Arm Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 216; 67; 21
      Pose Style: Axes
      Radius: 0.03
      Shaft Length: 0.06
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ur_path_transformed
      Value: true
    - Alpha: 0.45
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 112; 67
      Enabled: true
      Line Style: Lines
      Line Width: 0.02
      Name: Arm Path Original
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ur_path_original
      Value: true
    - Alpha: 1
      Axes Length: 0.25
      Axes Radius: 0.02
      Class: rviz_default_plugins/Pose
      Color: 76; 175; 80
      Enabled: true
      Head Length: 0.12
      Head Radius: 0.04
      Name: Robot Pose
      Shaft Length: 0.25
      Shaft Radius: 0.02
      Shape: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_pose
      Value: true
    - Alpha: 1
      Axes Length: 0.18
      Axes Radius: 0.015
      Class: rviz_default_plugins/Pose
      Color: 156; 39; 176
      Enabled: true
      Name: Current TCP Pose
      Shape: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /current_tcp_pose
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: robotnik_simple
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0.6
      Name: Current View
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 80
  Y: 80
