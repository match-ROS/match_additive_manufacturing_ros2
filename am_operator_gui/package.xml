<?xml version="1.0"?>
<package format="3">
  <name>am_operator_gui</name>
  <version>0.0.0</version>
  <description>PyQt5 reference GUI and local FastAPI operator GUI for additive manufacturing ROS 2 demos.</description>
  <maintainer email="rosmatch@todo.todo">rosmatch</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>base_trajectory_follower</exec_depend>
  <exec_depend>am_jparse_controller</exec_depend>
  <exec_depend>move_to_path_idx</exec_depend>
  <exec_depend>parse_paths</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-jinja2</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>ur_trajectory_follower</exec_depend>

  <test_depend>python3-pytest</test_depend>

